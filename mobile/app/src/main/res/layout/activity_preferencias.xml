<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/corFundoTela">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="30dp">

            <!-- CABEÇALHO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnVoltarPreferencias"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="‹"
                    android:textSize="36sp"
                    android:textColor="?attr/colorOnSurface"
                    android:contentDescription="Voltar"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preferências"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"/>

            </LinearLayout>

            <!-- TEMA DO SISTEMA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Tema do Sistema"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Modo"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>

            <Spinner
                android:id="@+id/spinnerTema"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_campo_conta"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <!-- CORES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Cor de destaque"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>

            <RadioGroup
                android:id="@+id/grupoCores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center">

                <RadioButton
                    android:id="@+id/corPadrao"
                    style="@style/ZattsCorOpcao"
                    android:button="@null"
                    android:drawableTop="@drawable/cor_padrao"
                    android:tag="#E6FB1A"
                    android:text="Padrão"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/corLaranja"
                    style="@style/ZattsCorOpcao"
                    android:button="@null"
                    android:text="Laranja"
                    android:tag="#FF8000"
                    android:drawableTop="@drawable/cor_laranja"
                    android:textSize="12sp"/>

                <RadioButton
                    android:id="@+id/corVermelho"
                    style="@style/ZattsCorOpcao"
                    android:button="@null"
                    android:text="Vermelho"
                    android:tag="#FF0000"
                    android:drawableTop="@drawable/cor_vermelho"
                    android:textSize="12sp"/>

                <RadioButton
                    android:id="@+id/corAzul"
                    style="@style/ZattsCorOpcao"
                    android:button="@null"
                    android:text="Azul"
                    android:tag="#4930FF"
                    android:drawableTop="@drawable/cor_azul"
                    android:textSize="12sp"/>

                <RadioButton
                    android:id="@+id/corRoxo"
                    style="@style/ZattsCorOpcao"
                    android:button="@null"
                    android:text="Roxo"
                    android:tag="#9000CC"
                    android:drawableTop="@drawable/cor_roxo"
                    android:textSize="12sp"/>

            </RadioGroup>

            <!-- IDIOMA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:text="Idioma"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Escolha o idioma de preferência"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"/>

            <Spinner
                android:id="@+id/spinnerIdioma"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_campo_conta"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- NAVBAR -->
    <com.zattsproject.mobile.AppNavBar
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="?attr/corFundoTela"/>

</FrameLayout>
