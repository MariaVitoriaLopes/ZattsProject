<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/corFundoTela"
    tools:context=".MetaActivity">

    <!-- CONTEÚDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- CABEÇALHO -->
            <LinearLayout
                android:id="@+id/headerMeta"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnVoltarMeta"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="‹"
                    android:textSize="36sp"
                    android:textColor="?attr/colorOnSurface"
                    android:contentDescription="Voltar"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minha meta"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- CONFIGURAÇÃO DA META -->
            <TextView
                style="@style/ContaSecao"
                android:layout_marginTop="24dp"
                android:text="Configuração da meta" />

            <TextView
                style="@style/ContaRotulo"
                android:text="Tipo de meta" />

            <Spinner
                android:id="@+id/spinnerTipoMeta"
                style="@style/ContaSpinner"
                android:minHeight="48dp" />

            <TextView
                style="@style/ContaRotulo"
                android:layout_marginTop="16dp"
                android:text="Valor da meta" />

            <EditText
                android:id="@+id/edtValorMeta"
                style="@style/ContaCampo"
                android:drawableEnd="@drawable/ic_conta_editar"
                android:hint="Digite o valor da meta"
                android:inputType="numberDecimal"
                android:minHeight="48dp" />

            <TextView
                android:id="@+id/txvUnidadeMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="kWh"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <!-- SALVAR ALTERAÇÕES -->
            <Button
                android:id="@+id/btnSalvarMeta"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:text="Salvar alterações"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnPrimary"
                android:backgroundTint="?attr/colorPrimary" />

            <!-- CANCELAR -->
            <Button
                android:id="@+id/btnCancelarMeta"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnSurface"
                android:backgroundTint="?attr/corFundoTela" />

        </LinearLayout>

    </ScrollView>

    <!-- NAVBAR -->
    <com.zattsproject.mobile.AppNavBar
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="?attr/corFundoTela" />

</FrameLayout>
