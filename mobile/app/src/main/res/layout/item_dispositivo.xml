<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- ÍCONE -->
        <ImageView
            android:id="@+id/iconeDispositivo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_public"
            android:background="@drawable/bg_dispositivo_icone"
            android:contentDescription="Ícone do dispositivo"/>

        <!-- INFORMAÇÕES -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txvNomeDispositivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Firefox (Windows 11)"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txvDataDispositivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conectado às 17:33"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"/>

                <TextView
                    android:id="@+id/txvStatusDispositivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="● Ativo"
                    android:textSize="12sp"
                    android:textColor="#00875A"/>

            </LinearLayout>

        </LinearLayout>

        <!-- DESCONECTAR -->
        <TextView
            android:id="@+id/btnDesconectarDispositivo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="Desconectar"
            android:textSize="13sp"
            android:textColor="#B83218"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- DIVISÓRIA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#80DADADA"/>

</LinearLayout>
