<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/corFundoTela"
    tools:context=".HistoryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="88dp">

        <!-- CABEÇALHO -->
        <TextView
            android:id="@+id/txvTituloHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Histórico Semanal"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"/>

        <!-- ABAS -->
        <HorizontalScrollView
            android:id="@+id/scrollAbasHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            android:background="@drawable/bg_notificacoes_abas">

            <LinearLayout
                android:id="@+id/layoutAbasHistorico"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tabSemanal"
                    style="@style/NotificacoesAba"
                    android:text="Semanal"
                    android:background="@drawable/bg_notificacoes_aba_ativa"
                    android:textColor="@color/textos_pretos"/>

                <TextView
                    android:id="@+id/tabMensal"
                    style="@style/NotificacoesAba"
                    android:text="Mensal"
                    android:textColor="@color/textos_pretos"/>

                <TextView
                    android:id="@+id/tabComparativo"
                    style="@style/NotificacoesAba"
                    android:text="Comparativo mensal"
                    android:textColor="@color/textos_pretos"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- CONTEÚDO -->
        <ScrollView
            android:id="@+id/scrollHistorico"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- EXPORTAR E PERÍODO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportarPdf"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="0.9"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Exportar PDF"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_download"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="?attr/colorOnSurface"
                        app:strokeColor="#80DADADA"
                        app:strokeWidth="1dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelecionarPeriodo"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1.25"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="18/Out - 24/Out de 2026"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_calendar"
                        app:iconGravity="textStart"
                        app:iconPadding="7dp"
                        app:iconTint="?attr/colorOnSurface"
                        app:strokeColor="#80DADADA"
                        app:strokeWidth="1dp"/>
                </LinearLayout>

                <!-- INDICADORES -->
                <LinearLayout
                    android:id="@+id/layoutIndicadores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="126dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/corFundoTela"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#80DADADA"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/txvTituloIndicador1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Consumo de energia"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/txvValorIndicador1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="68,3 kWh"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="21sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/txvDescricaoIndicador1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="Total de energia consumida na semana"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="10sp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="126dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/corFundoTela"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#80DADADA"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/txvTituloIndicador2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Custo estimado"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"/>

                            <TextView
                                android:id="@+id/txvValorIndicador2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="45,00 Reais"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="21sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/txvDescricaoIndicador2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:text="Valor estimado na semana com base na tarifa"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="10sp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- COMPARAÇÃO DE VALORES -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardComparacaoValores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="?attr/corFundoTela"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#80DADADA"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/txvTituloComparacao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Valor total por semana"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_card_home"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/txvRotuloAtual"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Semana atual"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="10sp"/>

                                <TextView
                                    android:id="@+id/txvValorAtual"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="R$ 45,00"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="19sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_marginStart="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_card_home"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/txvRotuloAnterior"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Semana anterior"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="10sp"/>

                                <TextView
                                    android:id="@+id/txvValorAnterior"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="R$ 43,50"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="19sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- GRÁFICO -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGraficoHistorico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="?attr/corFundoTela"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#80DADADA"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:id="@+id/txvTituloGrafico"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Consumo de energia semanal"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txvDescricaoGrafico"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Veja o consumo de energia (kWh) de cada dia da semana"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12sp"/>

                        <LinearLayout
                            android:id="@+id/layoutLegenda"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/corLegenda1"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:background="#DFFF00"/>

                            <TextView
                                android:id="@+id/txvLegenda1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:text="Consumo diário"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"/>

                            <View
                                android:id="@+id/corLegenda2"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="18dp"
                                android:background="#FF5A00"
                                android:visibility="gone"/>

                            <TextView
                                android:id="@+id/txvLegenda2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:text="Consumo anterior"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"
                                android:visibility="gone"/>
                        </LinearLayout>

                        <com.zattsproject.mobile.GraficoHistoricoView
                            android:id="@+id/graficoHistorico"
                            android:layout_width="match_parent"
                            android:layout_height="310dp"
                            android:layout_marginTop="8dp"/>

                        <View
                            android:id="@+id/indicadorRolagemGrafico"
                            android:layout_width="120dp"
                            android:layout_height="7dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:background="#AAAAAA"/>

                        <TextView
                            android:id="@+id/txvObservacaoGrafico"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center_vertical"
                            android:text="ⓘ  Os valores monetários são estimativas baseadas na tarifa configurada."
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- NAVBAR -->
    <com.zattsproject.mobile.AppNavBar
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="?attr/corFundoTela"/>

</FrameLayout>