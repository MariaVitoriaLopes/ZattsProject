<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/corFundoTela"
    tools:context=".AjudaSuporteActivity">

    <!-- CONTEÚDO -->
    <ScrollView
        android:id="@+id/scrollAjudaSuporte"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- CABEÇALHO -->
            <LinearLayout
                android:id="@+id/headerAjudaSuporte"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btn_voltar"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:clickable="true"
                    android:contentDescription="Voltar"
                    app:backgroundTint="?attr/corFundoTela"
                    app:tint="?attr/colorOnSurface"
                    app:elevation="0dp"
                    app:pressedTranslationZ="0dp"
                    app:fabSize="mini"
                    app:srcCompat="?attr/homeAsUpIndicator" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ajuda e Suporte"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- PERGUNTAS FREQUENTES -->
            <TextView
                style="@style/ContaSecao"
                android:layout_marginTop="24dp"
                android:text="Perguntas frequentes" />

            <TextView
                style="@style/ContaRotulo"
                android:layout_marginBottom="8dp"
                android:text="Encontre respostas rápidas sobre o uso do Zatts." />

            <!-- BUSCA -->
            <EditText
                android:id="@+id/edtBuscaFaq"
                style="@style/ContaCampo"
                android:layout_marginTop="4dp"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:hint="Buscar nas perguntas frequentes"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:minHeight="48dp" />

            <!-- FAQ 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFaq1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/corFundoTela"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/linhaFaq1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/txvPerguntaFaq1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Como conecto um novo dispositivo à minha conta?"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/iconeFaq1"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Expandir resposta"
                            android:src="@drawable/ic_expand_more"
                            app:tint="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txvRespostaFaq1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Para conectar um novo dispositivo, acesse a opção de dispositivos no aplicativo e siga as instruções de vinculação."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?android:attr/listDivider" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FAQ 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFaq2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/corFundoTela"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/linhaFaq2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/txvPerguntaFaq2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Por que meu dispositivo aparece como desconectado?"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/iconeFaq2"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Expandir resposta"
                            android:src="@drawable/ic_expand_more"
                            app:tint="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txvRespostaFaq2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Verifique se o dispositivo está ligado, conectado à rede e se a conexão com a internet está funcionando."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?android:attr/listDivider" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FAQ 3 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFaq3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/corFundoTela"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/linhaFaq3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/txvPerguntaFaq3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Como defino uma meta mensal de consumo?"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/iconeFaq3"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Expandir resposta"
                            android:src="@drawable/ic_expand_more"
                            app:tint="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txvRespostaFaq3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Acesse a área de metas, informe o limite de consumo desejado e salve a configuração."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?android:attr/listDivider" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FAQ 4 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFaq4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/corFundoTela"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/linhaFaq4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/txvPerguntaFaq4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Como crio um alerta personalizado?"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/iconeFaq4"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Expandir resposta"
                            android:src="@drawable/ic_expand_more"
                            app:tint="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txvRespostaFaq4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Na área de alertas, escolha a opção de criar alerta, defina as condições e salve."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?android:attr/listDivider" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FAQ 5 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFaq5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/corFundoTela"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/linhaFaq5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/txvPerguntaFaq5"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Como altero o tema ou cor de destaque?"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/iconeFaq5"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Expandir resposta"
                            android:src="@drawable/ic_expand_more"
                            app:tint="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txvRespostaFaq5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Acesse as configurações de aparência para selecionar o tema e a cor de destaque disponíveis."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?android:attr/listDivider" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FAQ 6 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFaq6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/corFundoTela"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/linhaFaq6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/txvPerguntaFaq6"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Esqueci minha senha. O que faço?"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/iconeFaq6"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Expandir resposta"
                            android:src="@drawable/ic_expand_more"
                            app:tint="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txvRespostaFaq6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Na tela de login, utilize a opção de recuperação de senha e siga as instruções enviadas ao seu e-mail."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?android:attr/listDivider" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FAQ 7 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFaq7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/corFundoTela"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/linhaFaq7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/txvPerguntaFaq7"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Como excluo minha conta e meus dados?"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/iconeFaq7"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Expandir resposta"
                            android:src="@drawable/ic_expand_more"
                            app:tint="?attr/colorOnSurface" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txvRespostaFaq7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Entre em contato com o suporte para receber orientações sobre a exclusão da conta e dos dados."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CANAIS DE SUPORTE -->
            <TextView
                style="@style/ContaSecao"
                android:layout_marginTop="30dp"
                android:text="Canais de suporte" />

            <TextView
                style="@style/ContaRotulo"
                android:layout_marginBottom="8dp"
                android:text="Escolha o canal mais conveniente para falar com a gente." />

            <LinearLayout
                android:id="@+id/cardEmailSuporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/iconeEmail"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_mail"
                    android:contentDescription="Ícone de e-mail" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="E-mail"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="zatts.suporte@gmail.com"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="28sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider" />

            <LinearLayout
                android:id="@+id/cardAtendimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/iconeAtendimento"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_schedule"
                    android:contentDescription="Ícone de relógio" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Atendimento"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Segunda a sexta, das 9h às 18h"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="28sp" />
            </LinearLayout>

            <!-- FALAR COM O SUPORTE -->
            <TextView
                style="@style/ContaSecao"
                android:layout_marginTop="30dp"
                android:text="Falar com o suporte" />

            <TextView
                style="@style/ContaRotulo"
                android:layout_marginBottom="12dp"
                android:text="Descreva o que aconteceu e responderemos pelo seu e-mail." />

            <TextView
                style="@style/ContaRotulo"
                android:text="Assunto" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutAssunto"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="dropdown_menu"
                app:hintEnabled="false">

                <AutoCompleteTextView
                    android:id="@+id/edtAssunto"
                    style="@style/ContaCampo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Selecione um assunto"
                    android:inputType="none"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/ContaRotulo"
                android:layout_marginTop="12dp"
                android:text="Mensagem" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutMensagem"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:counterEnabled="true"
                app:counterMaxLength="1000"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtMensagem"
                    style="@style/ContaCampo"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="top|start"
                    android:hint="Conte com detalhes como podemos ajudar"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="1000"
                    android:padding="12dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ENVIAR MENSAGEM -->
            <Button
                android:id="@+id/btnEnviarMensagem"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:text="Enviar mensagem"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnPrimary"
                android:backgroundTint="?attr/colorPrimary" />

        </LinearLayout>
    </ScrollView>

    <!-- NAVBAR -->
    <com.zattsproject.mobile.AppNavBar
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="?attr/corFundoTela" />

</FrameLayout>
