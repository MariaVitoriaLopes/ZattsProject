<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/corFundoTela"
    tools:context=".ContaActivity">

    <LinearLayout
        android:id="@+id/headerConta"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹"
            android:textSize="36sp"
            android:textColor="?attr/colorOnSurface"
            android:contentDescription="Voltar"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conta"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerConta"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/ContaSecao"
                android:text="Informações pessoais" />

            <TextView
                style="@style/ContaRotulo"
                android:text="Nome completo" />

            <EditText
                android:id="@+id/edtNome"
                style="@style/ContaCampo"
                android:hint="Nome completo"
                android:inputType="textPersonName"
                android:drawableEnd="@drawable/ic_conta_editar" />

            <TextView
                style="@style/ContaRotulo"
                android:text="E-mail" />

            <EditText
                android:id="@+id/edtEmail"
                style="@style/ContaCampo"
                android:hint="emailusuario@gmail.com"
                android:inputType="textEmailAddress"
                android:drawableEnd="@drawable/ic_conta_editar" />

            <TextView
                style="@style/ContaRotulo"
                android:text="Telefone" />

            <EditText
                android:id="@+id/edtTelefone"
                style="@style/ContaCampo"
                android:hint="(00) 00000-0000"
                android:inputType="phone"
                android:drawableEnd="@drawable/ic_conta_editar" />

            <TextView
                style="@style/ContaRotulo"
                android:text="Fuso Horário" />

            <Spinner
                android:id="@+id/spinnerFuso"
                style="@style/ContaSpinner" />

            <TextView
                style="@style/ContaSecao"
                android:layout_marginTop="28dp"
                android:text="Endereço" />

            <TextView
                style="@style/ContaRotulo"
                android:text="CEP" />

            <EditText
                android:id="@+id/edtCep"
                style="@style/ContaCampo"
                android:hint="00000-000"
                android:inputType="number"
                android:maxLength="9"
                android:drawableEnd="@drawable/ic_conta_editar" />

            <TextView
                style="@style/ContaRotulo"
                android:text="Logradouro *" />

            <EditText
                android:id="@+id/edtLogradouro"
                style="@style/ContaCampo"
                android:hint="Rua X"
                android:inputType="textCapWords"
                android:drawableEnd="@drawable/ic_conta_editar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        style="@style/ContaRotulo"
                        android:text="Número *" />

                    <EditText
                        android:id="@+id/edtNumero"
                        style="@style/ContaCampo"
                        android:hint="01"
                        android:inputType="text"
                        android:drawableEnd="@drawable/ic_conta_editar" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ContaRotulo"
                        android:text="Complemento" />

                    <EditText
                        android:id="@+id/edtComplemento"
                        style="@style/ContaCampo"
                        android:hint="Apartamento, bloco..."
                        android:inputType="textCapWords"
                        android:drawableEnd="@drawable/ic_conta_editar" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/ContaRotulo"
                android:text="Bairro *" />

            <EditText
                android:id="@+id/edtBairro"
                style="@style/ContaCampo"
                android:hint="Bairro"
                android:inputType="textCapWords"
                android:drawableEnd="@drawable/ic_conta_editar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ContaRotulo"
                        android:text="Cidade *" />

                    <EditText
                        android:id="@+id/edtCidade"
                        style="@style/ContaCampo"
                        android:hint="Praia Grande"
                        android:inputType="textCapWords"
                        android:drawableEnd="@drawable/ic_conta_editar" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ContaRotulo"
                        android:text="UF *" />

                    <Spinner
                        android:id="@+id/spinnerUf"
                        style="@style/ContaSpinner" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/ContaSecao"
                android:layout_marginTop="28dp"
                android:text="Gerenciar minha conta" />

            <TextView
                style="@style/ContaRotulo"
                android:text="Senha" />

            <EditText
                android:id="@+id/edtSenha"
                style="@style/ContaCampo"
                android:hint="Digite sua nova senha"
                android:inputType="textPassword"
                android:drawableEnd="@drawable/ic_conta_editar" />

            <TextView
                style="@style/ContaRotulo"
                android:text="Confirmação de senha" />

            <EditText
                android:id="@+id/edtConfirmarSenha"
                style="@style/ContaCampo"
                android:hint="Confirme sua nova senha"
                android:inputType="textPassword"
                android:drawableEnd="@drawable/ic_conta_editar" />

            <Button
                android:id="@+id/btnSalvarConta"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:text="Salvar alterações"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnPrimary"
                android:backgroundTint="?attr/colorPrimary" />

            <Button
                android:id="@+id/btnSairConta"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="Sair desta sessão"
                android:textAllCaps="false"
                android:textColor="@color/textos_brancos"
                android:backgroundTint="@color/fundo_900" />

            <Button
                android:id="@+id/btnExcluirConta"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Excluir minha conta"
                android:textAllCaps="false"
                android:textColor="@color/textos_brancos"
                android:backgroundTint="#B8321C" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ao deletar sua conta você concorda em perder todos os seus dados."
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>
    </ScrollView>

    <!-- NAVBAR EXISTENTE DO PROJETO -->
    <com.zattsproject.mobile.AppNavBar
        android:id="@+id/navBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="?attr/corFundoTela"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
